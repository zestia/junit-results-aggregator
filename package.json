{
  "name": "junit-results-aggregator",
  "version": "3.0.0",
  "description": "GitHub action for aggregating JUnit results",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "prettier": "prettier --write .",
    "test": "jest",
    "test:ci": "npm-run-all test lint",
    "lint": "npm-run-all lint:js lint:prettier",
    "lint:js": "eslint .",
    "lint:prettier": "prettier --check ."
  },
  "author": "Michael Stringer",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/artifact": "^2.3.1",
    "@actions/core": "^1.6.0",
    "@actions/github": "^6.0.0",
    "@actions/io": "^1.1.2",
    "date-fns": "^4.1.0",
    "ejs": "^3.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/ejs": "^3.1.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "jest": "^29.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.4",
    "rollup": "^4.60.4",
    "rollup-plugin-copy": "^3.5.0",
    "ts-jest": "^29.1.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
