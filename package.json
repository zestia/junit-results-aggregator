{
  "name": "junit-results-aggregator",
  "version": "3.0.0",
  "description": "GitHub action for aggregating JUnit results",
  "exports": {
    ".": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto --kill-others-on-fail --timings",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint --fix .",
    "lint:format": "prettier --check .",
    "lint:format:fix": "prettier --write .",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "test:ci": "npm-run-all test lint"
  },
  "author": "Michael Stringer",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@actions/io": "^3.0.2",
    "@eslint/eslintrc": "^3.3.5",
    "date-fns": "^4.1.0",
    "ejs": "^6.0.1",
    "eslint-plugin-prettier": "^5.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/ejs": "^3.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.2",
    "jest": "^30.4.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.4",
    "rollup": "^4.60.4",
    "rollup-plugin-copy": "^3.5.0",
    "ts-jest": "^29.1.2",
    "ts-jest-resolver": "^2.0.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.26.1"
  }
}
